{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "itsjimman-production-terminal",
  "main": "src/index.js",
  "compatibility_date": "2026-09-15",

  // The Flask app, built from ./Dockerfile and run as a Cloudflare Container.
  "containers": [
    {
      "class_name": "ProductionTerminalContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],

  // The Worker talks to the container through this Durable Object binding.
  "durable_objects": {
    "bindings": [
      {
        "name": "PRODUCTION_TERMINAL",
        "class_name": "ProductionTerminalContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProductionTerminalContainer"]
    }
  ],

  // Streams the Worker's own logs, and container start/stop/crash events,
  // to the dashboard's Logs tab — turned on temporarily to debug the
  // container startup failures we're chasing.
  "observability": {
    "enabled": true
  }
}
