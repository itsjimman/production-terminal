# Copy this file to .env and fill in real values before running for real.

# Everyone signs in with their own username + password now (set up by the
# Super Admin from the Admin page in-app) — there's nothing to configure
# here for login itself.

# Random long string used to sign session cookies. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-too

# Optional: point at a real Postgres/MySQL server instead of the bundled
# SQLite file once you deploy somewhere with a real database service.
# DATABASE_URL=postgresql://user:password@host:5432/itsjimman
